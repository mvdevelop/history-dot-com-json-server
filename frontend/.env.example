# Frontend Environment Variables
# Copy this file to .env and add your local environment variables

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_NODE_ENV=development

# Application Configuration
VITE_APP_TITLE=History.com
VITE_APP_DESCRIPTION=Full-stack historical content management platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_WEBSOCKETS=false
VITE_ENABLE_SEARCH=true
VITE_ENABLE_FILTERS=true

# Security
VITE_CORS_ORIGIN=http://localhost:5173
VITE_API_KEY=your-api-key-here

# Performance
VITE_ENABLE_IMAGES_OPTIMIZATION=true
VITE_IMAGE_MAX_SIZE=2048000
VITE_IMAGE_FORMAT=webp

# Development
VITE_SHOW_SERVER_TIMING=false
VITE_ENABLE_PERF_MEASUREMENTS=false
VITE_DEBUG_MODE=false

# Production (when using pm2/nginx)
# VITE_API_BASE_URL=https://api.history.com
# VITE_CORS_ORIGIN=https://history.com
# VITE_NODE_ENV=production